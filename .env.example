# Copy to .env and fill in. Never commit the real file.

# --- Supabase (required at build AND runtime; missing = 500 on all routes) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Gemini sentiment (Module 5) — server only ---
# Free key from Google AI Studio. Without it, feedback is saved but stays
# "pending analysis".
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash-lite
GEMINI_MODEL=

# Must equal the Vault secret `feedback_server_key` — see
# supabase/migrations/202610181000_feedback_protection.sql for setup.
FEEDBACK_SERVER_KEY=

# Public app URL — OG images, shared links, calendar files.
# Inlined at build time; changing it on the host requires a rebuild.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Privacy notice contact — optional; the fallbacks in utils/privacy.ts are
# placeholders. Set the real data privacy contact before going live.
# NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
# NEXT_PUBLIC_PRIVACY_CONTACT_PERSON=
